# Copy to .env and fill in. Never commit .env.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLAlchemy database URL. Leave unset to use a local SQLite file (app.db).
# PostgreSQL example:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/music_recommendation

# Path to the Firebase service-account key (optional; needed only for the admin Firebase page).
# FIREBASE_KEY_PATH=/path/to/firebase_key.json

# Used by create_admin.py
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
